&cable
   filename%met = '@MET@'
   filename%out = '@SITE@_out.nc'
   filename%log = '@SITE@_log.txt'
   filename%restart_in  = ' '
   filename%restart_out = '@SITE@_restart.nc'
   filename%type    = '@GRIDINFO@'
   filename%veg    = ''
   filename%soil    = ''
   vegparmnew = .TRUE.
   soilparmnew = .TRUE.
   spinup = .TRUE.          ! repeat the met record until soil moisture/temp converge (repo default is .FALSE.)
   delsoilM = 0.001
   delsoilT = 0.01
   output%restart = .TRUE.
   output%met = .TRUE.
   output%flux = .TRUE.
   output%soil = .TRUE.
   output%snow = .TRUE.
   output%radiation = .TRUE.
   output%carbon    = .TRUE.
   output%veg       = .TRUE.
   output%params    = .TRUE.
   output%patch     = .TRUE.
   output%balances  = .TRUE.
   check%ranges     = 0
   check%energy_bal = .TRUE.
   check%mass_bal   = .TRUE.
   verbose = .FALSE.
   leaps = .TRUE.
   logn = 88
   fixedCO2 = 350.0         ! only used if the met file has no CO2air; ask Anna what value to use
   spincasa      = .FALSE.
   l_casacnp     = .FALSE.
   l_laiFeedbk   = .FALSE.
   l_vcmaxFeedbk = .FALSE.
   icycle = 0
   ncciy = 0
   redistrb = .FALSE.
   wiltParam = 0.5
   satuParam = 0.8
   snmin = 1.0
   cable_user%FWSOIL_SWITCH = 'Haverd2013'
   cable_user%GS_SWITCH = 'medlyn'
   cable_user%DIAG_SOIL_RESP = 'ON '
   cable_user%LEAF_RESPIRATION = 'ON '
   cable_user%RUN_DIAG_LEVEL= 'BASIC'
   cable_user%CONSISTENCY_CHECK= .FALSE.
   cable_user%CASA_DUMP_READ = .FALSE.
   cable_user%CASA_DUMP_WRITE = .FALSE.
   cable_user%SSNOW_POTEV= 'HDM'
   cable_user%l_ice_consistency = .FALSE.
   cable_user%max_spins = 20   ! safety cap on spin-up cycles (code default -1 = no cap)
&end
